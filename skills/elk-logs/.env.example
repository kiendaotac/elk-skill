# Copy to ~/.config/elk-logs/env then: chmod 600 ~/.config/elk-logs/env
# Use your OWN account. Do not commit the real file.

# ---- prod ----
ELK_PROD_URL=https://kibana-prod.example.com
ELK_PROD_USER=your_prod_username
ELK_PROD_PASS=your_prod_password
# {service} is replaced by the repo/service name (or --service NAME)
ELK_PROD_INDEX_PATTERN=your-prod-prefix-{service}-*

# ---- dev ----
ELK_DEV_URL=https://kibana-dev.example.com
ELK_DEV_USER=your_dev_username
ELK_DEV_PASS=your_dev_password
ELK_DEV_INDEX_PATTERN=your-dev-prefix-{service}-*

# Alternative to user/pass (takes priority if set):
# ELK_PROD_API_KEY=your_prod_api_key
# ELK_DEV_API_KEY=your_dev_api_key

# Optional fallback index when not inside a git repo:
# ELK_PROD_INDEX=
# ELK_DEV_INDEX=
